{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "board-hub",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openboard-table-db",
      "database_id": "91fcfc64-31db-4857-9ef7-f9d66a75f532",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "TABLE_HOSTING": "cloudflare"
  }
}
